      }
    },
    "%@ (wired)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (por cable)"
          }
        }
      }
    },
    "%@ answered, but RCL isn’t accepting remote connections there. Check that RCL is open and Remote Access is on. If you changed its port, connect at home once." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ respondió, pero RCL no acepta conexiones remotas ahí. Revisa que RCL esté abierto y que Acceso remoto esté activado. Si cambiaste su puerto, conéctate una vez en casa."
          }
        }
      }
    },
    "%@ closed the connection. RCL will reconnect when it can." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cerró la conexión. RCL se reconectará cuando pueda."
          }
        }
      }
    },
    "%@ closed the connection. Tap it to try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cerró la conexión. Tócala para intentar de nuevo."
          }
        }
      }
    },
    "%@ Didn’t Answer" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió"
          }
        }
      }
    },
    "%@ didn’t answer at %@. If your home’s internet address changed, connect at home once to update it, or add an address name on the Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ didn’t answer at %2$@. If your home’s internet address changed, connect at home once to update it, or add an address name on the Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no respondió en %2$@. Si cambió la dirección de internet de tu casa, conéctate una vez en casa para actualizarla, o agrega un nombre de dirección en la Mac."
          }
        }
      }
    },
    "%@ didn’t answer. Check that RCL is open on it, then tap it again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió. Revisa que RCL esté abierto en ella y vuelve a tocarla."
          }
        }
      }
    },
    "%@ didn’t answer. It may be asleep, or %@ may be off on the Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ didn’t answer. It may be asleep, or %2$@ may be off on the Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no respondió. Puede estar en reposo, o %2$@ puede estar desactivado en la Mac."
          }
        }
      }
    },
    "%@ didn’t answer. It may be asleep." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió. Puede estar en reposo."
          }
        }
      }
    },
    "%@ didn’t answer. Open the menu again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió. Abre el menú de nuevo."
          }
        }
      }
    },
    "%@ didn’t answer. Try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió. Intenta de nuevo."
          }
        }
      }
    },
    "%@ didn’t show a code by itself. On the Mac, choose Pair iPhone or iPad… in the RCL menu." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no mostró un código por sí sola. En la Mac, elige Enlazar iPhone o iPad… en el menú de RCL."
          }
        }
      }
    },
    "%@ didn’t show a code. On the Mac, choose Pair iPhone or iPad… in the RCL menu, then tap %@ again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ didn’t show a code. On the Mac, choose Pair iPhone or iPad… in the RCL menu, then tap %2$@ again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no mostró un código. En la Mac, elige Enlazar iPhone o iPad… en el menú de RCL y vuelve a tocar %2$@."
          }
        }
      }
    },
    "%@ disconnected. It will reconnect when the Mac is back." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se desconectó. Se reconectará cuando la Mac vuelva."
          }
        }
      }
    },
    "%@ disconnected. RCL will reconnect when it can reach it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se desconectó. RCL se reconectará cuando pueda alcanzarla."
          }
        }
      }
    },
    "%@ has a new key since this %@ paired. Tap it to pair again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has a new key since this %2$@ paired. Tap it to pair again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene una clave nueva desde que este %2$@ se enlazó. Tócala para enlazar de nuevo."
          }
        }
      }
    },
    "%@ is already serving 8 devices." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya está atendiendo a 8 dispositivos."
          }
        }
      }
    },
    "%@ is locked" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está bloqueada"
          }
        }
      }
    },
    "%@ is saved. Tap it to connect." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está guardada. Tócala para conectarte."
          }
