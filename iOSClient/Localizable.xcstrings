    ", to move a window or select text." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", para mover una ventana o seleccionar texto."
          }
        }
      }
    },
    ": touch it and slide to make a window’s text larger or smaller." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ": tócalo y desliza para agrandar o reducir el texto de una ventana."
