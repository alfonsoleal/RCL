    },
    "%@ is showing a code. Point this %@ at it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is showing a code. Point this %2$@ at it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está mostrando un código. Apunta este %2$@ hacia él."
          }
        }
      }
    },
    "%@ is shutting down, restarting or logging out. This %@ reconnects when it’s back." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is shutting down, restarting or logging out. This %2$@ reconnects when it’s back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ se está apagando, reiniciando o cerrando sesión. Este %2$@ se reconecta cuando vuelva."
          }
        }
      }
    },
    "%@ isn’t answering. It may be asleep. RCL keeps trying, or tap it to try now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no responde. Puede estar en reposo. RCL sigue intentando, o tócala para intentar ahora."
          }
        }
      }
    },
    "%@ isn’t pairing right now. On your Mac, choose Pair iPhone or iPad… first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está enlazando ahora. En tu Mac, elige primero Enlazar iPhone o iPad…."
          }
        }
      }
    },
    "%@ isn’t responding." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no responde."
          }
        }
      }
    },
    "%@ kept its setting" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ conservó su ajuste"
          }
        }
      }
    },
    "%@ lets devices connect without pairing. Pair this %@ once to keep connecting if that changes, and to reach %@ away from home while Remote Access is on. %@ shows a code; scan it with this %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ lets devices connect without pairing. Pair this %2$@ once to keep connecting if that changes, and to reach %3$@ away from home while Remote Access is on. %4$@ shows a code; scan it with this %5$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ deja que los dispositivos se conecten sin enlazar. Enlaza este %2$@ una vez para seguir conectándote si eso cambia, y para llegar a %3$@ fuera de casa mientras Acceso remoto esté activado. %4$@ muestra un código; escanéalo con este %5$@."
          }
        }
      }
    },
    "%@ looks off on this %@. Turn it on, then tap %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ looks off on this %2$@. Turn it on, then tap %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ parece desactivado en este %2$@. Actívalo y luego toca %3$@."
          }
        }
      }
    },
    "%@ megabits per second" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ megabits por segundo"
          }
        }
      }
    },
