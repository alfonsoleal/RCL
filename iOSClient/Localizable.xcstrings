      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ no longer accepts this %2$@. Pair it again from RCL’s Settings on the Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya no acepta este %2$@. Enlázalo de nuevo desde los Ajustes de RCL en la Mac."
          }
        }
      }
    },
    "%@ now asks devices to pair. Tap it to pair this %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ now asks devices to pair. Tap it to pair this %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ahora pide a los dispositivos que se enlacen. Tócala para enlazar este %2$@."
          }
        }
      }
    },
    "%@ on the network answered with another key (-9808)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en la red respondió con otra clave (-9808)"
          }
        }
      }
    },
    "%@ on the network is another launch of RCL, or another Mac" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
