    " · " : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · "
          }
        }
      }
    },
    " a window to close, minimize or go full screen. Keep holding and drag to move it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " una ventana para cerrarla, minimizarla o ponerla en pantalla completa. Sigue manteniendo y arrastra para moverla."
          }
        }
      }
    },
    " at %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " en %@"
          }
        }
      }
    },
    " Away from home, this %@ asks for %lld fps, which halves the data your Mac sends." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : " Away from home, this %1$@ asks for %2$lld fps, which halves the data your Mac sends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Fuera de casa, este %1$@ pide %2$lld fps, lo que reduce a la mitad los datos que envía tu Mac."
          }
        }
      }
    },
    " for a trackpad and keys." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " para un trackpad y teclas."
          }
        }
      }
    },
    " Four-finger swipes and a Magic Keyboard trackpad’s gestures stay with iPadOS." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Los deslizamientos con cuatro dedos y los gestos del trackpad de un Magic Keyboard se quedan en iPadOS."
          }
        }
      }
    },
    " has actions: close, minimize, full screen, and move left or right. Swipe up or down to hear them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " tiene acciones: cerrar, minimizar, pantalla completa y mover a la izquierda o a la derecha. Desliza hacia arriba o hacia abajo para escucharlas."
          }
        }
      }
    },
    " is at the bottom of Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " está al final de Ajustes."
          }
        }
      }
    },
    " is there too, to see this again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " también está ahí, para volver a ver esto."
          }
        }
      }
    },
    " It needs version %@ or later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Necesita la versión %@ o posterior."
          }
        }
      }
    },
    " lists the apps on %@: tap an open one again for its next window." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " muestra las apps de %@: toca una abierta otra vez para ver su siguiente ventana."
          }
        }
      }
    },
    " lists the apps on %@. Choose an open one again for its next window." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " muestra las apps de %@. Elige una abierta otra vez para ver su siguiente ventana."
          }
        }
      }
    },
    " Low Power Mode holds this %@ to %lld fps." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : " Low Power Mode holds this %1$@ to %2$lld fps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " El Modo de bajo consumo limita este %1$@ a %2$lld fps."
          }
        }
      }
    },
    " makes a window’s text on %@ larger or smaller. Swipe up or down on it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " agranda o reduce el texto de una ventana en %@. Desliza hacia arriba o hacia abajo sobre él."
          }
        }
      }
    },
    " on the trackpad to right-click." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " en el trackpad para hacer clic secundario."
          }
        }
      }
    },
    " stay on for the next key or trackpad click: tap cmd, then C, to copy." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " se quedan activas para la siguiente tecla o clic del trackpad: toca cmd y luego C para copiar."
          }
        }
      }
    },
    " stay on for the next key: cmd, then C, copies." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " se quedan activas para la siguiente tecla: cmd y luego C copia."
          }
        }
      }
    },
    " the trackpad, " : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " el trackpad, "
          }
        }
      }
    },
    " They show again when you disconnect." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Vuelven a aparecer cuando te desconectas."
          }
        }
      }
    },
    " This %@ is connected directly: turning this off disconnects it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Este %@ está conectado directamente: si desactivas esto, se desconecta."
          }
        }
      }
    },
    " This %@ shows up to %lld fps." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : " This %1$@ shows up to %2$lld fps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Este %1$@ muestra hasta %2$lld fps."
          }
        }
      }
    },
    " to click." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " para hacer clic."
          }
        }
      }
    },
    " to right-click." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " para hacer clic secundario."
          }
        }
